# Clerk - Frontend API URL, production instance (dashboard.clerk.com -> API keys)
CLERK_FRONTEND_API_URL=

# Clerk - webhook signing secret for /clerk/events (dashboard.clerk.com -> Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=

# Domains
WEBSITE_ORIGIN=https://www.composery.io

CLOUD_DOMAIN=composery.cloud

# Polar Production - polar.sh
POLAR_ORGANIZATION_TOKEN=

POLAR_WEBHOOK_SECRET=

POLAR_BOX_AIR_MONTHLY_PRODUCT_ID=

POLAR_BOX_AIR_ANNUAL_PRODUCT_ID=

POLAR_BOX_PRO_MONTHLY_PRODUCT_ID=

POLAR_BOX_PRO_ANNUAL_PRODUCT_ID=

POLAR_ENVIRONMENT=production

# Hetzner - console.hetzner.cloud
HETZNER_CLOUD_TOKEN=

HETZNER_BOX_LOCATIONS=nbg1,fsn1,hel1

HETZNER_BOX_IMAGE=docker-ce

# Key name or numeric id from the project SSH keys, comma-separated for multiple
HETZNER_SSH_KEYS=

# Hypervisor-level allowlist every box gets: inbound TCP 22/80/443 from anywhere,
# nothing else inbound, no outbound rules. See docs/developing/web/services/hetzner.md
HETZNER_FIREWALL_ID=

# Cloudflare - dash.cloudflare.com (DNS edit token + zone id)
CLOUDFLARE_DNS_TOKEN=

CLOUDFLARE_ZONE_ID=

# Runtime container
RUNTIME_IMAGE=ghcr.io/sloikodavid/composery:latest

RUNTIME_PORT=8080

# The control plane's own way into a box's HOST - the Hetzner server, not the
# instance running on it. Used for the whole lifecycle (bootstrap, repair,
# update, rescue), never as customer-facing access. An instance's own SSH
# service is a separate thing an owner reaches with their own key; see
# docs/self-hosting/index.md.
HOST_SSH_USER=root

HOST_SSH_PRIVATE_KEY=

# Resend - resend.com (alerts, box notices, account and legal notices)
RESEND_API_KEY=

RESEND_WEBHOOK_SECRET=

# Three addresses at one verified domain. An address is free; a verified domain
# costs a reputation only volume earns. At roughly 100 account holders, or the
# first marketing send, the streams move onto their own domains and only the
# part after the @ changes:
#
#   RESEND_ALERTS_FROM=Composery Alerts <alerts@alerts.composery.io>
#   RESEND_NOTICES_FROM=Composery Notices <notices@mail.composery.io>
#   RESEND_ACCOUNTS_FROM=Composery Accounts <accounts@mail.composery.io>
#
# Why, and what else that costs: docs/developing/web/services/resend.md.

# Internal incident mail
RESEND_ALERTS_FROM=Composery Alerts <alerts@composery.io>

# Box notices - deleted, suspended, unsuspended, create failed. Its own address
# so a recipient can mute box mail without muting the account notices they are
# legally owed
RESEND_NOTICES_FROM=Composery Notices <notices@composery.io>

# Account and legal notices. Unset, none is sent to anyone and the console says
# so - see convex/legalNotice.ts
RESEND_ACCOUNTS_FROM=Composery Accounts <accounts@composery.io>
