# Clerk - Frontend API URL (dashboard.clerk.com -> API keys)
CLERK_FRONTEND_API_URL=

# Clerk - webhook signing secret for /clerk/events (dashboard.clerk.com -> Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=

# Domains
WEBSITE_ORIGIN=http://localhost:3000

CLOUD_DOMAIN=dev.composery.cloud

# Polar Sandbox - sandbox.polar.sh
POLAR_ORGANIZATION_TOKEN=

POLAR_WEBHOOK_SECRET=

POLAR_BOX_AIR_MONTHLY_PRODUCT_ID=

POLAR_BOX_AIR_ANNUAL_PRODUCT_ID=

POLAR_BOX_PRO_MONTHLY_PRODUCT_ID=

POLAR_BOX_PRO_ANNUAL_PRODUCT_ID=

POLAR_ENVIRONMENT=sandbox

# Hetzner - console.hetzner.cloud
HETZNER_CLOUD_TOKEN=

HETZNER_BOX_LOCATIONS=nbg1,fsn1,hel1

HETZNER_BOX_IMAGE=docker-ce

# Key name or numeric id from the project SSH keys, comma-separated for multiple
HETZNER_SSH_KEYS=

# Hypervisor-level allowlist every box gets: inbound TCP 22/80/443 from anywhere,
# nothing else inbound, no outbound rules. See docs/developing/web/services/hetzner.md
HETZNER_FIREWALL_ID=

# Cloudflare - dash.cloudflare.com (DNS edit token + zone id)
CLOUDFLARE_DNS_TOKEN=

CLOUDFLARE_ZONE_ID=

# Runtime container
RUNTIME_IMAGE=ghcr.io/sloikodavid/composery:latest

RUNTIME_PORT=8080

# The control plane's own way into a box's HOST - the Hetzner server, not the
# instance running on it. Used for the whole lifecycle (bootstrap, repair,
# update, rescue), never as customer-facing access. An instance's own SSH
# service is a separate thing an owner reaches with their own key; see
# docs/self-hosting/index.md.
HOST_SSH_USER=root

HOST_SSH_PRIVATE_KEY=

# Resend - resend.com (alerts, box notices, account and legal notices)
RESEND_API_KEY=

RESEND_WEBHOOK_SECRET=

# All three share Resend's test address, which only delivers to the Resend
# account owner - that is what makes rehearsing a legal notice safe. Sharing one
# address means only the display name says which sender sent what.
RESEND_ALERTS_FROM=Composery Alerts <onboarding@resend.dev>

RESEND_NOTICES_FROM=Composery Notices <onboarding@resend.dev>

RESEND_ACCOUNTS_FROM=Composery Accounts <onboarding@resend.dev>
