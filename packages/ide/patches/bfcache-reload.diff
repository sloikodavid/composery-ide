Reload a workbench restored from the back/forward cache.

A bfcache restore hands back the DOM with every socket dead, so the workbench
comes back looking alive over a connection that died while it was away - the
state VS Code can only offer to reload out of. `persisted` is true for that
restore and nothing else, so an ordinary load never reaches the reload.

no-store used to keep these pages out of the bfcache on its own; Chrome on
Android now caches them anyway. A vendor-behaviour workaround, kept
individually deletable.

--- a/lib/vscode/src/vs/workbench/browser/client.ts
+++ b/lib/vscode/src/vs/workbench/browser/client.ts
@@ -117,12 +117,26 @@ export class CodeServerClient extends Disposable {
 		});
 
 		this.addShowQrCommand();
+		this.reloadOnBackForwardRestore();
 
 		if (this.productService.serviceWorker) {
 			await this.registerServiceWorker(this.productService.serviceWorker);
 		}
 	}
 
+	// Composery: a page restored from the back/forward cache keeps its DOM but not
+	// its sockets, so the workbench comes back looking alive over a connection that
+	// died while it was away - the state VS Code can only offer to reload out of.
+	// `persisted` is true for that restore and nothing else, so an ordinary load
+	// never reaches the reload.
+	private reloadOnBackForwardRestore(): void {
+		window.addEventListener('pageshow', event => {
+			if (event.persisted) {
+				window.location.reload();
+			}
+		});
+	}
+
