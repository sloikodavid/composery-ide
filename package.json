{
	"name": "composery",
	"version": "0.1.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
	"engines": {
		"node": ">=24.18.1 <25"
	},
	"scripts": {
		"dev": "concurrently -n tree,docker,convex,next,colors -c green,blue,yellow,yellow,cyan \"pnpm dev:tree\" \"pnpm dev:docker\" \"pnpm dev:convex\" \"pnpm dev:next\" \"pnpm dev:colors\"",
		"dev:next": "pnpm --filter web dev:next",
		"dev:convex": "pnpm --filter web dev:convex",
		"dev:docker": "docker compose --progress=plain -f compose.dev.yaml up --build",
		"dev:tree": "node scripts/tree.mjs --watch",
		"dev:colors": "pnpm --filter shared dev:colors",
		"check": "pnpm check:portable && pnpm check:knip && pnpm check:coverage && pnpm check:cli && pnpm check:mutants && pnpm check:renovate",
		"check:portable": "pnpm check:types && pnpm check:lint && pnpm check:format && pnpm check:whitelist && pnpm check:test && pnpm check:tree && pnpm check:ide && pnpm check:assets",
		"check:types": "tsc --noEmit && pnpm -r --if-present run check:types",
		"check:lint": "eslint . --max-warnings 0 && pnpm -r --if-present run check:lint",
		"check:format": "prettier --check .",
		"check:whitelist": "node scripts/whitelist.mjs",
		"check:test": "vitest run --coverage",
		"check:tree": "node scripts/tree.mjs",
		"check:renovate": "pnpm dlx --package renovate renovate-config-validator renovate.json",
		"check:ide": "pnpm --filter ide check",
		"check:cli": "node scripts/cli.mjs",
		"check:assets": "pnpm --filter shared check",
		"check:coverage": "node scripts/coverage.mjs",
		"check:knip": "knip",
		"check:mutants": "node scripts/mutants.mjs",
		"fix": "pnpm fix:tree && pnpm fix:lint && pnpm fix:format && pnpm fix:cli && pnpm fix:whitelist",
		"fix:tree": "node scripts/tree.mjs --write",
		"fix:whitelist": "node scripts/whitelist.mjs --write",
		"fix:lint": "eslint . --fix && pnpm -r --if-present run fix:lint",
		"fix:format": "prettier --write .",
		"fix:cli": "node scripts/cli.mjs --fix",
		"fix:assets": "pnpm --filter shared build",
		"build": "pnpm build:web && pnpm build:image",
		"build:web": "pnpm --filter web build",
		"build:image": "docker compose --progress=plain -f compose.dev.yaml build",
		"system:smoke": "node tests/system/smoke.mjs",
		"system:overlay": "bash tests/system/overlay/run.sh",
		"system:identity": "bash tests/system/identity/run.sh",
		"system:templates": "node tests/system/templates/run.mjs schemas",
		"system:compose": "node tests/system/templates/run.mjs compose",
		"system:providers": "node tests/system/providers/run.mjs",
		"system:registry": "node tests/system/registry/run.mjs",
		"system:artifacts": "node tests/system/artifacts/run.mjs",
		"setup": "node scripts/setup.mjs"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@types/jsdom": "^28.0.3",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "4.1.10",
		"ajv": "^8.20.0",
		"concurrently": "^10.0.4",
		"eslint": "catalog:",
		"fast-check": "^4.9.0",
		"jsdom": "^30.0.1",
		"knip": "^6.31.0",
		"prettier": "3.9.6",
		"typescript": "catalog:",
		"typescript-eslint": "8.65.0",
		"vitest": "catalog:",
		"yaml": "^2.9.0"
	}
}
